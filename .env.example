# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (cp .env.example .env)
# .env 파일은 외부에 공유하거나 저장소에 올리지 않습니다.

# 심사위원 접속 코드 (필수, 사업단이 심사위원에게 안내)
JUDGE_CODE=

# 관리자(/admin) 비밀번호 (필수)
ADMIN_PASSWORD=

# 구글 폼 응답 연동 (선택) - 응답 시트에 배포한 Apps Script 웹 앱 주소(/exec로 끝남)와 스크립트 속성 SYNC_KEY 값
FORM_SYNC_URL=
FORM_SYNC_KEY=

# 접수 마감 시각 (이후 제출은 불러오기 화면에서 "마감 후"로 표시되고 기본 제외)
IMPORT_DEADLINE=2026-11-25T23:59:59+09:00

# 서버에서 열 포트 (docker-compose의 127.0.0.1:포트)
HOST_PORT=8080
